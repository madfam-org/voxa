# Environment variables (copy to .env.local)

# API — omit for local JSON file store under ./data; set for PostgreSQL
# DATABASE_URL=postgresql://voxa:voxa@localhost:5432/voxa
# File-store directory when DATABASE_URL is unset (default ./data)
# VOXA_DATA_DIR=./data
# Max pooled Postgres connections per API process (default 5; shared server budget)
# DATABASE_POOL_MAX=5
# Startup retry budget for a transient connection refusal, ms (default 30000; 0 disables)
# DATABASE_STARTUP_RETRY_MS=30000
PORT=4000

# Web
# Production API (mobile release builds, EAS secrets, etc.)
# NEXT_PUBLIC_API_URL=https://voxa-api.madfam.io
NEXT_PUBLIC_API_URL=http://localhost:4000
