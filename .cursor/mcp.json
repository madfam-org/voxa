{
  "mcpServers": {
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    },
    "animotion": {
      "command": "npx",
      "args": [
        "-y",
        "animotion-mcp"
      ]
    },
    "threejs": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-threejs"
      ]
    },
    "@magicuidesign/mcp": {
      "command": "npx",
      "args": [
        "-y",
        "@magicuidesign/mcp@latest"
      ]
    },
    "shadcn": {
      "command": "npx",
      "args": [
        "shadcn@latest",
        "mcp"
      ]
    }
  }
}
