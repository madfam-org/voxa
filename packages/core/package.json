{
  "name": "@voxa/core",
  "version": "0.1.0",
  "private": true,
  "description": "Core domain models for Voxa AAC boards, buttons, and profiles",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/starter-boards.test.ts src/keyboard-input.test.ts",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
