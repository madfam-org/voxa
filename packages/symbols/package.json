{
  "name": "@voxa/symbols",
  "version": "0.1.0",
  "private": true,
  "description": "Mulberry Symbols (CC BY-SA 4.0): resolver, licence metadata and offline keyword search",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./search": {
      "types": "./dist/search.d.ts",
      "default": "./dist/search.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/run-unit-tests.mjs",
    "clean": "rm -rf dist",
    "build:index": "node scripts/build-mulberry-index.mjs"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@voxa/core": "workspace:*"
  }
}
