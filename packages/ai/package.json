{
  "name": "@voxa/ai",
  "version": "0.1.0",
  "private": true,
  "description": "AI service contracts — LLM prediction, PictoBERT, symbol generation, TTS",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
