{
  "name": "@voxa/obf",
  "version": "0.1.0",
  "private": true,
  "description": "Open Board Format (.obf / .obz) import and export",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/index.test.ts src/obz.test.ts src/images.test.ts src/zip.test.ts src/spec-conformance.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@voxa/core": "workspace:*",
    "@voxa/symbols": "workspace:*",
    "@voxa/vocabulary": "workspace:*",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
