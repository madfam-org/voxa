{
  "name": "@voxa/obf",
  "version": "0.1.0",
  "private": true,
  "description": "Open Board Format (.obf / .obz) import and export",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@voxa/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
