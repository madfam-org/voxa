{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/madfam-org/voxa/packages/obf/schema/obf-0.1.schema.json",
  "title": "Open Board Format 0.1 board (.obf)",
  "description": "Written by Voxa from the OBF specification (https://www.openboardformat.org/docs) and the open-aac/obf reference validator. Cross-references (grid.order ids exist in buttons, image_id/sound_id exist in images/sounds, grid.order has rows x columns cells) cannot be expressed in JSON Schema and are checked in packages/obf/src/spec-conformance.test.ts. Differences from the reference validator: images[].width/height and sounds[].duration are optional here (the spec lists them; Voxa does not invent sizes it does not know).",
  "type": "object",
  "required": [
    "format",
    "id",
    "locale",
    "grid",
    "buttons",
    "images",
    "sounds"
  ],
  "properties": {
    "format": {
      "type": "string",
      "const": "open-board-0.1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "locale": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}([-_][A-Za-z0-9]{2,8})*$"
    },
    "url": {
      "type": "string"
    },
    "data_url": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description_html": {
      "type": "string"
    },
    "default_layout": {
      "type": "string"
    },
    "grid": {
      "type": "object",
      "required": [
        "rows",
        "columns",
        "order"
      ],
      "properties": {
        "rows": {
          "type": "integer",
          "minimum": 1
        },
        "columns": {
          "type": "integer",
          "minimum": 1
        },
        "order": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      },
      "patternProperties": {
        "^ext_": {}
      },
      "additionalProperties": false
    },
    "buttons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string"
          },
          "vocalization": {
            "type": "string"
          },
          "image_id": {
            "type": "string"
          },
          "sound_id": {
            "type": "string"
          },
          "background_color": {
            "type": "string",
            "pattern": "^\\s*rgba?\\(\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*(,\\s*(0|1|0?\\.\\d+|1\\.0+)\\s*)?\\)\\s*$"
          },
          "border_color": {
            "type": "string",
            "pattern": "^\\s*rgba?\\(\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*(,\\s*(0|1|0?\\.\\d+|1\\.0+)\\s*)?\\)\\s*$"
          },
          "hidden": {
            "type": "boolean"
          },
          "action": {
            "type": "string",
            "pattern": "^[:+]"
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "load_board": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "data_url": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            },
            "patternProperties": {
              "^ext_": {}
            },
            "additionalProperties": false
          },
          "top": {
            "type": "number",
            "minimum": 0
          },
          "left": {
            "type": "number",
            "minimum": 0
          },
          "width": {
            "type": "number",
            "minimum": 0
          },
          "height": {
            "type": "number",
            "minimum": 0
          }
        },
        "patternProperties": {
          "^ext_": {}
        },
        "additionalProperties": false
      }
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "allOf": [
          {
            "anyOf": [
              {
                "required": [
                  "url"
                ]
              },
              {
                "required": [
                  "data"
                ]
              },
              {
                "required": [
                  "path"
                ]
              },
              {
                "required": [
                  "symbol"
                ]
              }
            ]
          }
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string"
          },
          "data": {
            "type": "string",
            "pattern": "^data:image/[^;]+;base64,.+$"
          },
          "data_url": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "not": {
              "pattern": "(^/|\\\\|(^|/)\\.\\.(/|$))"
            }
          },
          "content_type": {
            "type": "string",
            "pattern": "^image/.+$"
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "license": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string"
              },
              "copyright_notice_url": {
                "type": "string"
              },
              "source_url": {
                "type": "string"
              },
              "author_name": {
                "type": "string"
              },
              "author_url": {
                "type": "string"
              },
              "author_email": {
                "type": "string"
              }
            },
            "patternProperties": {
              "^ext_": {}
            },
            "additionalProperties": false
          },
          "symbol": {
            "type": "object",
            "properties": {
              "set": {
                "type": "string"
              },
              "filename": {
                "type": "string"
              }
            }
          }
        },
        "patternProperties": {
          "^ext_": {}
        },
        "additionalProperties": false
      }
    },
    "sounds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "allOf": [
          {
            "anyOf": [
              {
                "required": [
                  "url"
                ]
              },
              {
                "required": [
                  "data"
                ]
              },
              {
                "required": [
                  "path"
                ]
              }
            ]
          }
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string"
          },
          "data": {
            "type": "string",
            "pattern": "^data:audio/[^;]+;base64,.+$"
          },
          "data_url": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "not": {
              "pattern": "(^/|\\\\|(^|/)\\.\\.(/|$))"
            }
          },
          "content_type": {
            "type": "string",
            "pattern": "^audio/.+$"
          },
          "duration": {
            "type": "number",
            "minimum": 0
          },
          "license": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string"
              },
              "copyright_notice_url": {
                "type": "string"
              },
              "source_url": {
                "type": "string"
              },
              "author_name": {
                "type": "string"
              },
              "author_url": {
                "type": "string"
              },
              "author_email": {
                "type": "string"
              }
            },
            "patternProperties": {
              "^ext_": {}
            },
            "additionalProperties": false
          }
        },
        "patternProperties": {
          "^ext_": {}
        },
        "additionalProperties": false
      }
    },
    "license": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "copyright_notice_url": {
          "type": "string"
        },
        "source_url": {
          "type": "string"
        },
        "author_name": {
          "type": "string"
        },
        "author_url": {
          "type": "string"
        },
        "author_email": {
          "type": "string"
        }
      },
      "patternProperties": {
        "^ext_": {}
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^ext_": {}
  },
  "additionalProperties": false
}
