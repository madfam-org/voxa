{
  "name": "voxa",
  "version": "1.0.0",
  "private": true,
  "description": "Next-generation Augmentative and Alternative Communication (AAC) platform — cross-platform, GLP-native, AI-powered, and open by design.",
  "author": "MADFAM <hello@madfam.io>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/madfam-org/voxa"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "pnpm --filter @voxa/web dev",
    "dev:api": "pnpm --filter @voxa/api dev",
    "dev:mobile": "pnpm --filter @voxa/mobile dev",
    "build": "turbo build",
    "test": "turbo test --filter=!@voxa/e2e",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "test:e2e": "pnpm --filter @voxa/e2e test",
    "test:e2e:smoke": "pnpm --filter @voxa/e2e test:smoke",
    "test:e2e:a11y": "pnpm --filter @voxa/e2e test:a11y",
    "test:e2e:staging": "pnpm --filter @voxa/e2e test:staging"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.4.2",
    "shadcn": "^4.11.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
