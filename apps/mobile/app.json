{
  "expo": {
    "name": "Voxa",
    "slug": "voxa",
    "version": "0.5.0",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "voxa",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.madfam.voxa",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "package": "io.madfam.voxa",
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0a0a"
        }
      ]
    ],
    "extra": {
      "apiUrl": "http://localhost:4000",
      "webUrl": "http://localhost:3000",
      "oidcIssuer": "https://auth.madfam.io",
      "oidcClientId": "voxa"
    }
  }
}
