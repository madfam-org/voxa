{
  "name": "@voxa/web",
  "version": "1.0.0",
  "private": true,
  "description": "Augmentative & alternative communication. A Spanish-first communication board that turns direct touch, switch scanning or pointer dwell into speech with the device voice you choose (es-MX first); core boards in 24, 36 and 60 cells on one stable motor plan, offline use after the first visit, and Open Board Format (OBF/OBZ) exchange — at home, in therapy, and in class.",
  "scripts": {
    "dev": "next dev --port 3000",
