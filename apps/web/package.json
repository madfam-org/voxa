    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/run-unit-tests.mjs"
  },
  "dependencies": {
    "@voxa/access": "workspace:*",
    "@voxa/ai": "workspace:*",
    "@voxa/core": "workspace:*",
    "@voxa/i18n": "workspace:*",
    "@voxa/obf": "workspace:*",
    "@voxa/symbols": "workspace:*",
    "@voxa/sync": "workspace:*",
    "@voxa/ui": "workspace:*",
    "@voxa/vocabulary": "workspace:*",
    "jose": "^5.9.6",
    "next": "^15.5.27",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.1",
