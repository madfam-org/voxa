{
  "name": "@voxa/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/health.test.ts src/store/board-operations.test.ts src/routes/boards.routes.test.ts src/routes/events.routes.test.ts src/routes/media.routes.test.ts src/routes/symbols.routes.test.ts src/lib/janua.test.ts src/lib/board-access.test.ts src/lib/dhanam.test.ts src/lib/ws-auth.test.ts src/ws/sync-hub.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-cli.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@hono/node-ws": "^1.1.1",
    "@voxa/ai": "workspace:*",
    "@voxa/core": "workspace:*",
    "@voxa/obf": "workspace:*",
    "@voxa/symbols": "workspace:*",
    "@voxa/vocabulary": "workspace:*",
    "drizzle-orm": "^0.39.3",
    "hono": "^4.6.14",
    "ioredis": "^5.4.2",
    "jose": "^5.9.6",
    "postgres": "^3.4.5",
    "@sentry/node": "^8.47.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
