{
  "name": "@voxa/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/run-unit-tests.mjs --import ./src/test-support/isolated-data-dir.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-cli.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@hono/node-ws": "^1.1.1",
    "@voxa/ai": "workspace:*",
    "@voxa/core": "workspace:*",
    "@voxa/import-adapters": "workspace:*",
    "@voxa/obf": "workspace:*",
    "@voxa/symbols": "workspace:*",
    "@voxa/vocabulary": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "ioredis": "^5.4.2",
    "jose": "^5.9.6",
    "postgres": "^3.4.5",
    "@sentry/node": "^10.76.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "fflate": "^0.8.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
