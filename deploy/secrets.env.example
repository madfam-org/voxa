# Copy to secrets.env for onboarding — do not commit real values.
# Direct connection to the Postgres server (port 5432), not through a pooler.
# The server is shared under a fixed connection limit: see docs/deploy/ENCLII.md.
DATABASE_URL=postgresql://REPLACE_USER:REPLACE@REPLACE_POSTGRES_HOST:5432/REPLACE_DB
# Shared Redis: it requires AUTH, and each app gets its own DB index (the
# platform operator assigns it). Compose the URL on the operator host only.
REDIS_URL=redis://:REPLACE_URL_ENCODED_PASSWORD@REPLACE_REDIS_HOST:6379/REPLACE_DB_INDEX
# When REDIS_URL is set and reachable, the API fans out WebSocket sync events
# and counts presence across replicas (/health/ready: "syncHub":"redis").
# Unreachable: it keeps serving in local mode and reports a syncHubWarning.
